---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import cvPage1 from '@/assets/cv/cv-page-1.png';
import cvPage2 from '@/assets/cv/cv-page-2.png';

const pdfHref = '/cv-douwe-rijs.pdf';
const pages = [
  { src: cvPage1, alt: 'Résumé of Douwe Rijs, page 1 of 2: profile, education and experience.' },
  {
    src: cvPage2,
    alt: 'Résumé of Douwe Rijs, page 2 of 2: selected projects, technical skills and languages.',
  },
];
---

<BaseLayout
  title="Résumé"
  description="Résumé of Douwe Rijs — Robotics & Machine Learning Engineer, MSc Robotics at TU Delft."
>
  <section class="mx-auto max-w-4xl px-6 pt-20 pb-10 sm:pt-28">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h1 class="display-lg text-ink">Résumé</h1>
      <a
        href={pdfHref}
        download="cv-douwe-rijs.pdf"
        class="shrink-0 rounded-full bg-accent px-5 py-2.5 text-sm font-medium text-on-accent transition-opacity hover:opacity-90"
      >
        Download PDF
      </a>
    </div>
    <p class="mt-6 max-w-2xl text-muted">
      Robotics &amp; ML engineer with experience building real-world perception, software and ML
      systems across the autonomy stack. Two pages —{' '}
      <a href={pdfHref} class="text-accent underline underline-offset-4">view the PDF</a> or download
      it above.
    </p>
  </section>

  <section class="mx-auto max-w-4xl px-6 pb-20">
    <div class="space-y-8">
      {
        pages.map((page) => (
          <a href={pdfHref} aria-label="Open the résumé PDF" class="block">
            <Image
              src={page.src}
              alt={page.alt}
              widths={[640, 960, 1240]}
              sizes="(max-width: 896px) 100vw, 896px"
              class="w-full rounded-lg border border-line bg-white shadow-sm"
            />
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
